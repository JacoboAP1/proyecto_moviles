{
  "expo": {
    "name": "OficiAR",
    "slug": "oficiar",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/logo_oficiar.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "scheme": "oficiar",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación requiere acceso a tus fotos para cambiar la imagen de perfil.",
          "cameraPermission": "La aplicación requiere acceso a la cámara para tomar una foto de perfil."
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/logo_oficiar.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.victormanuel1.oficiar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_oficiar.png",
        "backgroundColor": "#051A26"
      },
      "package": "com.victormanuel1.oficiar"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a5c48cd-16d8-4833-9f25-e9fdf77bbd72"
      }
    },
    "owner": "victormanuel1"
  }
}
