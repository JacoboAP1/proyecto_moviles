    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
